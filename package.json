{
  "name": "@mindemangou/magiccomponents",
  "version": "9.1.3",
  "type": "module",
  "description": "MagicComponents is a JavaScript library that allows you to easily create custom elements",
  "author": "Mindemangou FADONOUGBO",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindemangou/magic-components"
  },
  "bugs": {
    "url": "https://github.com/mindemangou/magic-components/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "web-components",
    "web-component",
    "reactjs",
    "custom elements",
    "component"
  ],
  "exports": {
    ".": {
      "import": "./dist/magiccomponents.es.js",
      "types": "./dist/magictypes.d.ts",
      "require": "./dist/magiccomponents.cjs.js"
    },
    "./react": {
      "import": "./dist/magiccomponents-react.es.js",
      "types": "./dist/magictypes-react.d.ts",
      "require": "./dist/magiccomponents-react.cjs.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b  && vite build && cp ./src/magictypes.d.ts ./dist/magictypes.d.ts && cp ./src/magictypes-react.d.ts ./dist/magictypes-react.d.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "pnpm run build && pnpm publish",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.3.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "^17.6.3",
    "jsdom": "^26.1.0",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2",
    "morphdom": "^2.7.8",
    "nanostores": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
